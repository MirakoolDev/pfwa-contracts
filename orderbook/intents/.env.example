# The deployed order book contracts on Robinhood Chain (from script/Deploy.s.sol)
OB_FACTORY=
OB_FORWARDER=
# Optional: a Robinhood Chain RPC (defaults to the public one)
ROBINHOOD_RPC_URL=
# Optional: NEAR Intents partner key (https://partners.near-intents.org). Without it quotes carry +0.25%.
ONECLICK_API_KEY=
# Keeper only: a key that pays gas for execute/refund. It never holds user funds.
KEEPER_PRIVATE_KEY=
# Where the keeper keeps its orders (default orders.json)
INTENTS_STORE=
